{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "angular-material-extended": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": ".",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": {
              "base": "dist/angular-material-extended"
            },
            "index": "src/index.html",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "src/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "@angular/material/prebuilt-themes/azure-blue.css",
              "src/styles.scss",
              "dist/display-dialog/styles.css",
              "dist/edit-entity-dialog/styles.css"
            ],
            "scripts": [],
            "browser": "src/main.ts"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1mb",
                  "maximumError": "2mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "5kb",
                  "maximumError": "10kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "angular-material-extended:build:production"
            },
            "development": {
              "buildTarget": "angular-material-extended:build:development",
              "port": 4242
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "angular-material-extended:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "src/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "@angular/material/prebuilt-themes/azure-blue.css",
              "src/styles.scss",
              "dist/display-dialog/styles.css",
              "dist/edit-entity-dialog/styles.css"
            ],
            "scripts": []
          }
        }
      }
    },
    "NgxMatDatatable": {
      "projectType": "library",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/datatable",
      "sourceRoot": "projects/datatable/src",
      "prefix": "NgxMat",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/datatable/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/datatable/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/datatable/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/datatable/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    },
    "NgxMatTooltip": {
      "projectType": "library",
      "root": "projects/tooltip",
      "sourceRoot": "projects/tooltip/src",
      "prefix": "NgxMat",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/tooltip/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/tooltip/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/tooltip/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/tooltip/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    },
    "NgxMatSectionTabs": {
      "projectType": "library",
      "root": "projects/section-tabs",
      "sourceRoot": "projects/section-tabs/src",
      "prefix": "NgxMat",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/section-tabs/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/section-tabs/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/section-tabs/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/section-tabs/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    },
    "NgxMatDisplayDialog": {
      "projectType": "library",
      "root": "projects/display-dialog",
      "sourceRoot": "projects/display-dialog/src",
      "prefix": "NgxMat",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/display-dialog/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/display-dialog/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/display-dialog/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/display-dialog/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    },
    "NgxMatEditEntityDialog": {
      "projectType": "library",
      "root": "projects/edit-entity-dialog",
      "sourceRoot": "projects/edit-entity-dialog/src",
      "prefix": "NgxMat",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/edit-entity-dialog/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/edit-entity-dialog/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/edit-entity-dialog/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/edit-entity-dialog/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
