{
  "name": "@eherve/angular-material-extended",
  "version": "19.0.0",
  "author": "Eric Herve <eric.herve.95@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eherve/angular-material-extended.git"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:datatable": "ng test NgxMatDatatable --watch=false --browsers=ChromeHeadless",
    "test:tooltip": "ng test NgxMatTooltip --watch=false --browsers=ChromeHeadless",
    "test:demo": "ng test angular-material-extended --watch=false --browsers=ChromeHeadless",
    "build:datatable": "ng build NgxMatDatatable",
    "build:demo": "ng build angular-material-extended",
    "check:datatable": "npm run test:datatable && npm run build:datatable && npm run test:demo && npm run build:demo",
    "build:tooltip": "ng build NgxMatTooltip",
    "publish:datatable": "ng build NgxMatDatatable && cd dist/datatable && npm publish && cd -",
    "publish:tooltip": "ng build NgxMatTooltip && cd dist/tooltip && npm publish && cd -",
    "build:section-tabs": "ng build NgxMatSectionTabs",
    "test:section-tabs": "ng test NgxMatSectionTabs --watch=false --browsers=ChromeHeadless",
    "build:display-dialog": "ng build NgxMatDisplayDialog",
    "test:display-dialog": "ng test NgxMatDisplayDialog --watch=false --browsers=ChromeHeadless",
    "build:edit-entity-dialog": "ng build NgxMatEditEntityDialog",
    "test:edit-entity-dialog": "ng test NgxMatEditEntityDialog --watch=false --browsers=ChromeHeadless",
    "check:tooltip": "npm run test:tooltip && npm run build:tooltip",
    "test:organigram:model": "node --test projects/organigram/tests/*.test.mjs",
    "test:organigram": "ng test NgxMatOrganigram --watch=false --browsers=ChromeHeadless",
    "build:organigram": "ng build NgxMatOrganigram",
    "check:organigram": "npm run test:organigram:model && npm run test:organigram && npm run build:organigram",
    "build:range-selector": "ng build NgxMatRangeSelector",
    "test:range-selector": "ng test NgxMatRangeSelector --watch=false --browsers=ChromeHeadless",
    "check:range-selector": "npm run test:range-selector && npm run build:range-selector"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@angular/animations": "^22.2.1",
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/material": "^22.2.2",
    "@angular/material-moment-adapter": "^22.2.2",
    "@angular/platform-browser": "^22.2.1",
    "@angular/platform-browser-dynamic": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@dagrejs/dagre": "3.1.1",
    "@ng-matero/extensions": "^22.1.1",
    "@ng-matero/extensions-moment-adapter": "^22.0.0",
    "dayjs": "^1.11.20",
    "humanize-duration": "^3.32.1",
    "moment": "^2.30.1",
    "ngx-countup": "^13.2.0",
    "ngx-intersection-observer": "^1.0.13",
    "rxjs": "~7.8.0",
    "subsink": "^1.0.2",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.2",
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.1",
    "@types/humanize-duration": "^3.27.4",
    "@types/jasmine": "~5.1.0",
    "@types/lodash-es": "^4.17.12",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.4.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lodash-es": "^4.17.21",
    "ng-packagr": "^22.2.4",
    "prettier": "3.4.2",
    "typescript": "~6.0.3"
  }
}
